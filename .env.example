# SQLite (dev default). For Postgres: postgresql://user:pass@host:5432/inventorylens
DATABASE_URL="file:../.data/dev.db"

# Required: master secret for AES-256-GCM encryption of stored API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# Confidence threshold (0-1). Below this, Identify shows top-3 candidates.
MATCH_THRESHOLD=0.7

# Which provider powers the optional vision re-rank pass: openai | google | anthropic
VISION_RERANK_PROVIDER=openai
